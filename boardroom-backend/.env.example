# Copy to .env to override defaults. .env is gitignored.
#
# Auth: this backend uses claude-agent-sdk which subprocesses the `claude` CLI.
# The CLI handles auth via either:
#   (a) `claude login` — uses your Claude Max subscription (recommended)
#   (b) ANTHROPIC_API_KEY env var — uses API billing
# You don't need to set ANTHROPIC_API_KEY here if you've run `claude login`.

# Where to bind the HTTP server.
HOST=127.0.0.1
PORT=8100

# Path to the directory containing per-VP subfolders.
BOARDROOM_VPS_DIR=./vps

# SQLite database file for VP tactical state + briefing history.
BOARDROOM_DB_PATH=./boardroom.db

# Models. The Agent SDK passes these through to the `claude` CLI as `--model`.
VP_MODEL=claude-sonnet-4-6
WORKER_MODEL=claude-haiku-4-5-20251001
DIRECTOR_MODEL=claude-opus-4-7

# PostgreSQL (Neon) — storage for the 3-tier memory model + VP records.
# Use Neon's *pooled* connection string (host contains "-pooler"). KEEP IT
# SECRET, never commit it. Schema: db/schema.sql
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Notion MCP (read-only access for VPs). Create an internal integration at
# https://www.notion.so/my-integrations, then share target pages/databases
# with the integration. Leave blank to disable Notion tools.
NOTION_API_KEY=
